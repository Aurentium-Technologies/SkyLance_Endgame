+#if ORIENT_FATHOM_PREFIX_LENGTH
+// The scalar first-accepted length is monotone in code. Equal lengths at
+// both endpoints therefore prove a length for every code in that interval.
+static void init_prefix_lengths(struct PairsData *d)
+{
+  for (unsigned prefix = 0; prefix < 256; ++prefix) {
+#ifdef DECOMP64
+    uint64_t low = (uint64_t)prefix << 56;
+    uint64_t high = low | UINT64_C(0x00ffffffffffffff);
+#else
+    uint32_t low = (uint32_t)prefix << 24;
+    uint32_t high = low | UINT32_C(0x00ffffff);
+#endif
+    int lower = 0, upper = 0;
+    while (low < d->base[lower]) ++lower;
+    while (high < d->base[upper]) ++upper;
+    d->prefixLen[prefix] = lower == upper ? (uint8_t)(d->minLen + lower) : 0;
+  }
+}
+#endif
