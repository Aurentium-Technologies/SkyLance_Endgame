+// Fixed diagnostic bookkeeping is deliberately excluded from requested reader
+// payload. Diagnostic calls are serialized by the harness/Orient adapter.
+struct OrientTbAllocationRecord { void *pointer; size_t size; unsigned category; };
+struct OrientTbMappingRecord { void *pointer; size_t size; };
+static struct OrientTbAllocationRecord orientTbAllocations[32768];
+static struct OrientTbMappingRecord orientTbMappings[8192];
+static struct OrientTbDiagnostics orientTbDiagnostics;
+static void orient_tb_record_allocation(void *pointer, size_t size, unsigned category)
+{
+  if (!pointer) return;
+  for (size_t i = 0; i < sizeof(orientTbAllocations) / sizeof(*orientTbAllocations); ++i)
+    if (!orientTbAllocations[i].pointer) {
+      orientTbAllocations[i].pointer = pointer;
+      orientTbAllocations[i].size = size;
+      orientTbAllocations[i].category = category;
+      struct OrientTbAllocationStats *s = &orientTbDiagnostics.allocations[category];
+      s->live_bytes += size;
+      if (s->live_bytes > s->peak_bytes) s->peak_bytes = s->live_bytes;
+      ++s->allocations;
+      return;
+    }
+  fprintf(stderr, "Fathom diagnostic allocation ledger exhausted\n");
+  abort();
+}
+static void orient_tb_forget_allocation(void *pointer)
+{
+  if (!pointer) return;
+  for (size_t i = 0; i < sizeof(orientTbAllocations) / sizeof(*orientTbAllocations); ++i)
+    if (orientTbAllocations[i].pointer == pointer) {
+      struct OrientTbAllocationStats *s = &orientTbDiagnostics.allocations[orientTbAllocations[i].category];
+      assert(s->live_bytes >= orientTbAllocations[i].size);
+      s->live_bytes -= orientTbAllocations[i].size;
+      ++s->frees;
+      orientTbAllocations[i].pointer = NULL;
+      return;
+    }
+  fprintf(stderr, "Fathom diagnostic free of untracked allocation\n");
+  abort();
+}
+static void *orient_tb_malloc(size_t size, unsigned category)
+{
+  void *pointer = malloc(size);
+  orient_tb_record_allocation(pointer, size, category);
+  return pointer;
+}
+static void orient_tb_free(void *pointer)
+{
+  orient_tb_forget_allocation(pointer);
+  free(pointer);
+}
+static void orient_tb_record_mapping(void *pointer, size_t size)
+{
+  if (!pointer) return;
+  for (size_t i = 0; i < sizeof(orientTbMappings) / sizeof(*orientTbMappings); ++i)
+    if (!orientTbMappings[i].pointer) {
+      orientTbMappings[i].pointer = pointer; orientTbMappings[i].size = size;
+      ++orientTbDiagnostics.map_calls;
+      orientTbDiagnostics.mapped_bytes += size;
+      if (orientTbDiagnostics.mapped_bytes > orientTbDiagnostics.peak_mapped_bytes)
+        orientTbDiagnostics.peak_mapped_bytes = orientTbDiagnostics.mapped_bytes;
+      return;
+    }
+  fprintf(stderr, "Fathom diagnostic mapping ledger exhausted\n");
+  abort();
+}
+static void orient_tb_forget_mapping(void *pointer)
+{
+  if (!pointer) return;
+  for (size_t i = 0; i < sizeof(orientTbMappings) / sizeof(*orientTbMappings); ++i)
+    if (orientTbMappings[i].pointer == pointer) {
+      assert(orientTbDiagnostics.mapped_bytes >= orientTbMappings[i].size);
+      orientTbDiagnostics.mapped_bytes -= orientTbMappings[i].size;
+      ++orientTbDiagnostics.unmap_calls;
+      orientTbMappings[i].pointer = NULL;
+      return;
+    }
+  fprintf(stderr, "Fathom diagnostic unmap of untracked mapping\n");
+  abort();
+}
+#define ORIENT_TB_MALLOC(size, category) orient_tb_malloc((size), (category))
+#define ORIENT_TB_FREE(pointer) orient_tb_free(pointer)
+#else
+#define ORIENT_TB_MALLOC(size, category) malloc(size)
+#define ORIENT_TB_FREE(pointer) free(pointer)
+#endif
 
