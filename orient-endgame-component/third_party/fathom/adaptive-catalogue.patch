+#if ORIENT_FATHOM_DYNAMIC_CATALOG
+// A complete successful directory listing bounds discovery, without imposing a
+// five-piece limit. If listing is unavailable, retain the original full scan.
+static unsigned orient_tb_discovery_bound(void)
+{
+#ifdef ORIENT_FATHOM_DYNAMIC_CATALOG_TEST
+  if (orientTbForceListingFailure) return TB_PIECES;
+#endif
+#if defined(__cplusplus) && __cplusplus >= 201703L
+  try {
+    unsigned largest = 0;
+    for (int pathIndex = 0; pathIndex < numPaths; ++pathIndex) {
+      std::error_code error;
+      std::filesystem::directory_iterator next(paths[pathIndex], error), end;
+      if (error) return TB_PIECES;
+      while (next != end) {
+        const std::string name = next->path().filename().string();
+        if (name.size() >= 5) {
+          std::string suffix = name.substr(name.size() - 5);
+          // POSIX filesystems can also be case-insensitive. Folding ASCII
+          // names may conservatively overestimate on a case-sensitive mount,
+          // but must never skip a file the unchanged canonical open can find.
+          for (char& c : suffix) if (c >= 'A' && c <= 'Z') c = char(c - 'A' + 'a');
+          if (suffix == ".rtbw") {
+            const std::string material = name.substr(0, name.size() - 5);
+            unsigned kings = 0, separators = 0, pieces = 0;
+            bool valid = true;
+            for (char c : material) {
+              if (c == 'V') c = 'v';
+              else if (c >= 'a' && c <= 'z' && c != 'v') c = char(c - 'a' + 'A');
+              if (c == 'v') { ++separators; continue; }
+              if (!strchr("KQRBNP", c)) { valid = false; break; }
+              ++pieces; if (c == 'K') ++kings;
+            }
+            if (valid && kings == 2 && separators == 1 && pieces >= 3 && pieces <= TB_PIECES
+                && pieces > largest) largest = pieces;
+          }
+        }
+        next.increment(error);
+        if (error) return TB_PIECES;
+      }
+    }
+    return largest;
+  } catch (...) {
+    return TB_PIECES;
+  }
+#else
+  return TB_PIECES;
+#endif
+}
+
+static void orient_tb_release_catalogues(void)
+{
+#if defined(__cplusplus) && (__cplusplus >= 202002L)
+#if ORIENT_FATHOM_DIAGNOSTICS
+  orient_tb_forget_allocation(pieceEntry);
+  orient_tb_forget_allocation(pawnEntry);
+#endif
+  delete[] pieceEntry;
+  delete[] pawnEntry;
+#else
+  ORIENT_TB_FREE(pieceEntry);
+  ORIENT_TB_FREE(pawnEntry);
+#endif
+  pieceEntry = NULL; pawnEntry = NULL;
+  orientTbPieceCapacity = orientTbPawnCapacity = 0;
+}
+
+static bool orient_tb_allocate_catalogues(unsigned pieces, unsigned pawns)
+{
+#ifdef ORIENT_FATHOM_DYNAMIC_CATALOG_TEST
+  orientTbAllocationAttempts = 0;
+  if (orientTbForceAllocationFailure) return false;
+#endif
+  if (pieces == orientTbPieceCapacity && pawns == orientTbPawnCapacity) return true;
+  orient_tb_release_catalogues();
+#if defined(__cplusplus) && (__cplusplus >= 202002L)
+  pieceEntry = pieces && !ORIENT_TB_FAIL_CATALOGUE_ALLOCATION()
+      ? new (std::nothrow) PieceEntry[pieces]() : NULL;
+  pawnEntry = pawns && !ORIENT_TB_FAIL_CATALOGUE_ALLOCATION()
+      ? new (std::nothrow) PawnEntry[pawns]() : NULL;
+#if ORIENT_FATHOM_DIAGNOSTICS
+  if (pieceEntry) orient_tb_record_allocation(pieceEntry, pieces * sizeof(*pieceEntry), ORIENT_TB_CATALOG);
+  if (pawnEntry) orient_tb_record_allocation(pawnEntry, pawns * sizeof(*pawnEntry), ORIENT_TB_CATALOG);
+#endif
+#else
+  pieceEntry = pieces && !ORIENT_TB_FAIL_CATALOGUE_ALLOCATION()
+      ? (struct PieceEntry*)ORIENT_TB_MALLOC(pieces * sizeof(*pieceEntry), ORIENT_TB_CATALOG) : NULL;
+  pawnEntry = pawns && !ORIENT_TB_FAIL_CATALOGUE_ALLOCATION()
+      ? (struct PawnEntry*)ORIENT_TB_MALLOC(pawns * sizeof(*pawnEntry), ORIENT_TB_CATALOG) : NULL;
+#endif
+  if ((pieces && !pieceEntry) || (pawns && !pawnEntry)) {
+    orient_tb_release_catalogues();
+    return false;
+  }
+  orientTbPieceCapacity = pieces; orientTbPawnCapacity = pawns;
+  return true;
+}
+#endif
